{
    "editor.fontFamily": "Maple Mono Normal NF CN",
    "editor.fontLigatures": true,
    "editor.fontSize": 15,
    "editor.lineHeight": 20,
    "editor.fontWeight": "bold",
    "files.autoSave": "afterDelay",
    "files.autoGuessEncoding": true,
    "workbench.list.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "editor.cursorBlinking": "smooth",
    "editor.mouseWheelZoom": true,
    "debug.console.fontFamily": "Maple Mono Normal NF CN",
    "debug.console.fontSize": 15,
    "terminal.integrated.fontFamily": "Maple Mono Normal NF CN",
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.fontWeightBold":"900",
    "terminal.integrated.tabs.enabled": true,
    "workbench.iconTheme": "catppuccin-mocha",
    "chat.editor.fontWeight": "bold",
    "errorLens.fontWeight": "bold",
    "go.toolsManagement.autoUpdate": true,
    "clangd.detectExtensionConflicts": false,
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask",
    ],
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.sqlite3": "default",
        "{git,gitlens,git-graph}:/**/*.{md,csv,svg}": "default",
    },
    "python.createEnvironment.trigger": "off",
    "git.openRepositoryInParentFolders": "never",
    "workbench.editor.enablePreview": false,
    "git.autofetch": true,
    "liveServer.settings.donotShowInfoMsg": true,
    "editor.fontVariations": false,
    "latex.linter.enabled": false,
    "latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.showContextMenu": true,
    "latex-workshop.intellisense.package.enabled": true,
    "latex-workshop.message.error.show": false,
    "latex-workshop.message.warning.show": false,
    "latex-workshop.latex.tools": [
        {
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOCFILE%",
            ],
        },
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOCFILE%",
            ],
        },
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOCFILE%",
            ],
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": [
                "%DOCFILE%"
            ],
        },
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "XeLaTeX",
            "tools": [
                "xelatex"
            ],
        },
        {
            "name": "PDFLaTeX",
            "tools": [
                "pdflatex"
            ],
        },
        {
            "name": "BibTeX",
            "tools": [
                "bibtex"
            ],
        },
        {
            "name": "LaTeXmk",
            "tools": [
                "latexmk"
            ],
        },
        {
            "name": "xelatex -> bibtex -> xelatex*2",
            "tools": [
                "xelatex",
                "bibtex",
                "xelatex",
                "xelatex"
            ],
        },
        {
            "name": "pdflatex -> bibtex -> pdflatex*2",
            "tools": [
                "pdflatex",
                "bibtex",
                "pdflatex",
                "pdflatex"
            ],
        },
    ],
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.bbl",
        "*.blg",
        "*.idx",
        "*.ind",
        "*.lof",
        "*.lot",
        "*.out",
        "*.toc",
        "*.acn",
        "*.acr",
        "*.alg",
        "*.glg",
        "*.glo",
        "*.gls",
        "*.ist",
        "*.fls",
        "*.log",
        "*.fdb_latexmk",
    ],
    "latex-workshop.latex.autoClean.run": "onFailed",
    "latex-workshop.latex.recipe.default": "lastUsed",
    "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
    "editor.unicodeHighlight.allowedLocales": {
        "zh-hans": true,
        "zh-hant": true,
    },
    "[latex]": {
        "editor.defaultFormatter": "James-Yu.latex-workshop",
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "editor.codeActionsOnSave": {},
    "editor.dropIntoEditor.preferences": [],
    "workbench.colorCustomizations": {
        "editor.background": "#1E2326E6",
        "editorGutter.background": "#1E2326E6",
        "sideBar.background": "#1E2326B3",
        "activityBar.background": "#1E2326B3",
        "statusBar.background": "#1E2326B3",
        "tab.activeBackground": "#2D353B99",
        "tab.inactiveBackground": "#1E2326A6",
        "editorGroupHeader.tabsBackground": "#1E2326B3",
        "panel.background": "#1E2326B3",
        "titleBar.activeBackground": "#1E2326B3",
        "titleBar.inactiveBackground": "#1E2326B3",
        "input.background": "#1E2326A6"
    },
    "oneDarkPro.bold": true,
    "oneDarkPro.italic": false,
    "prettier.tabWidth": 4,
    "chat.instructionsFilesLocations": {
        ".github/instructions": true,
    },
    "terminal.integrated.stickyScroll.enabled": false,
    "git.confirmSync": false,
    "workbench.productIconTheme": "bongocat",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "@azure.argTenant": "",
    "cph.general.defaultLanguage": "cpp",
    "cph.language.cpp.Args": "-std=c++17",
    "chat.hookFilesLocations": {
        ".github/hooks": true,
        ".claude/settings.local.json": true,
        ".claude/settings.json": true,
        "~/.claude/settings.json": true,
        "~/.agents/hooks": true,
    },
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*",
    },
    "docker.extension.enableComposeLanguageServer": false,
    "chat.viewSessions.orientation": "stacked",
    "workbench.preferredDarkColorTheme": "One Dark Pro",
    "editor.minimap.enabled": false,
    "editor.lineNumbers": "relative",
    "catppuccin.italicComments": false,
    "catppuccin.italicKeywords": false,
    "catppuccin.workbenchMode": "flat",
    "editor.semanticHighlighting.enabled": true,
    "animations.CursorAnimation": true,
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.fontWeight": "bold",
    "editor.codeLensFontFamily": "Maple Mono Normal NL NF CN",
    "background.editor": {
        "useFront": true,
        "style": {
            "background-position": "100% 100%",
            "background-size": "auto",
            "opacity": 0.6,
        },
        "styles": [],
        "images": [],
        "interval": 0,
        "random": false,
    },
    "animations.Enabled": true,
    "workbench.settings.applyToAllProfiles": [],
    "mergeEditor.diffAlgorithm": "legacy",
    "workbench.experimental.modernUI": false,
    "vscode_vibrancy.preferredLightTheme": "Default Dark",
    "window.commandCenter": false,
    "window.customTitleBarVisibility": "never",
    "window.vibrancy": "default",
    "docker.extension.dockerEngineAvailabilityPrompt": false,
    "editor.stickyScroll.enabled": false,
    "workbench.colorTheme": "Everforest Dark",
    "json.schemas": [],
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true,
    },
    "rust-analyzer.server.path": "rust-analyzer",
    "rust-analyzer.check.command": "clippy",
    "rust-analyzer.cargo.buildScripts.enable": true,
    "rust-analyzer.procMacro.enable": true,
    "rust-analyzer.checkOnSave": true,
    "rust-analyzer.rustfmt.extraArgs": [
        "+stable",
    ],
    "gitlens.currentLine.fontWeight": "bold",
    "errorLens.alignMessage": {

        "start": 0,
        "end": 0,
        "minimumMargin": 4,
        "padding": [
            0,
            0
        ],
        "useFixedPosition": true
    },
    "everforest.italicComments": false,
    "vscode_vibrancy.opacity": 0,
    "everforest.darkContrast": "hard",
}
